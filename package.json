{
  "name": "tripest",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "TripLog — 離線優先的旅行行程與支出記錄 PWA",
  "scripts": {
    "dev": "vite",
    "icons": "node scripts/gen-icons.mjs",
    "build": "npm run icons && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:zh": "node tools/check-zh.mjs",
    "server:start": "node server/src/index.js",
    "server:test": "node server/test/smoke.mjs",
    "mcp:build": "vite build --config vite.mcp.config.ts",
    "mcp:test": "npm run mcp:build && node server/test/mcp-smoke.mjs",
    "mcp": "node mcp/bin.mjs",
    "verify": "npm run check:zh && tsc --noEmit && vitest run && node server/test/smoke.mjs && npm run mcp:test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "dexie": "^4.0.8",
    "leaflet": "^1.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.12",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "fake-indexeddb": "^6.0.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.6",
    "vite-plugin-pwa": "^0.20.5",
    "vitest": "^2.1.1"
  }
}
