# 複製成 .env 後依實際環境調整；docker compose 會自動讀同目錄的 .env

# 沒有網域時，靜態站對外監聽的埠（http://<VPS IP>:$TRIPLOG_PORT）
TRIPLOG_PORT=8080

# 0.0.0.0 = 允許直接由埠存取；前面擺了 Caddy 時可改成 127.0.0.1 強制走 HTTPS
TRIPLOG_BIND=0.0.0.0

# 填了它，deploy.sh 才會啟用 --profile tls 啟動 Caddy 自動簽憑證。
# 留空代表只有 HTTP（PWA 的 Service Worker 與「安裝到主畫面」不會生效）。
TRIPLOG_DOMAIN=

# ------------------------------------------------------------ 同步／agent API
# 這一段全部留空＝完全不啟動後端，佈署出來的東西跟以前一樣只有一個靜態站。
# 要跨裝置同步或讓 AI agent 寫資料時，才把寫入金鑰填進來（deploy.sh 看到它才會多掛
# deploy/compose.api.yml）。金鑰產生方式：openssl rand -hex 32
#
# 注意：.env 已经被 .gitignore 擋掉，永遠不要 commit；這把金鑰等於整個旅行資料庫的密碼，
# app 裡只存在 localStorage（設定 → 跨裝置同步），不會寫進任何一筆備份檔。

# 寫入金鑰（至少 24 字元，太短 API 容器會直接拒絕啟動）
TRIPLOG_API_KEY=

# 只讀金鑰：給「只想看資料」的 agent 用，它讀得到但推不進去。
# 留空的話讀取也跟 TRIPLOG_API_KEY 同一把（就失去分級意義了）
TRIPLOG_READ_KEY=

# 基準檔保留幾份歷史快照（1～200，預設 20）；誤檔或資料長壞時用得上
TRIPLOG_KEEP=20

# CORS 放行來源，例：https://triplogmo.duckdns.org。
# app 跟 API 同網域（走 Caddy 反代）時留空就好；只有從本機 vite 直接打线上 API 才需要填
TRIPLOG_ALLOWED_ORIGIN=

# 每分鐘請求上限（讀／寫），防止拿到網址的人狂推
TRIPLOG_RATE_READ=600
TRIPLOG_RATE_WRITE=60

# 分享連結的每分鐘上限，同一個 token 加同一個 IP 分開算。
# 同行者一直按重新整理也用不完；設太寬只是多給別人猜 token 的機會
TRIPLOG_RATE_SHARE_READ=240
TRIPLOG_RATE_SHARE_WRITE=30

# 配對碼（8 個字，一次性）的每分鐘嘗試上限，以 IP 為單位。
# 猜中的機率本來就很低，這條是把「慢慢試」變成「試不動」；設 0 等於不限制，不建議
TRIPLOG_RATE_PAIR=8

# ------------------------------------------------------- 帳號模式（Google 登入）
# 把登入變成進來的唯一路，並且「一個 Google 帳號一份基準檔」。預設關：留空時
# 整套行為跟以前完全一樣（一把主金鑰＝一座資料庫），可以放心先部署再慢慢開啟。
#
# 開啟前要先在 Google Cloud Console 建一個 OAuth 2.0「Web 應用」用戶端：
#   - 已獲授權的 JavaScript 來源：https://<你的網域>
#   - 已獲授權的重導向 URI：https://<你的網域>
#   Client ID 是公開資訊（會被瀏覽器看到），不是金鑰，可以進 .env 但不要進 commit。
# 這裡不需要 client_secret：我們驗的是 Google 簽發的 ID token，不換 access token。
TRIPLOG_AUTH=
# 例：1234567890-abcdez.apps.googleusercontent.com
TRIPLOG_GOOGLE_CLIENT_ID=

# 帳號模式開著時，是否還讓主金鑰與 tlk_ 憑證進得來（預設開）。
# 它們看到的是「帳號制度之前那份基準」，現在主要用來做救援與跑 agent；
# 想徹底關掉就設 0，屆時資料只能從 SSH 處理（server/src/cli.js）。
TRIPLOG_AUTH_ALLOW_KEYS=1

# 一條登入（session）的有效期天數，1～365，預設 30。常用裝置會自動滑動續期，
# 所以這其實是「連續這麼多天沒上線就要重新登入」。
TRIPLOG_SESSION_DAYS=30

# 登入端點的每分鐘嘗試上限（以 IP 為單位）。正常用量一人一兩次就夠，
# 它是讓「拿別人的 token 一直試」變成行不通的事
TRIPLOG_RATE_AUTH=12

# 只允許某個 Google Workspace 網域的帳號登入（例：example.com）。留空＝任何人都能登。
TRIPLOG_GOOGLE_HOSTED_DOMAIN=

# 驗簽用的公鑰位置。留空＝Google 官方網址，正常部署不要動它；
# 只有本地測試會把它指到一個假的 JWKS 伺服器。
TRIPLOG_GOOGLE_JWKS_URL=
